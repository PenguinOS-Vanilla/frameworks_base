<!-- Captions button background inside the One UI card: nothing when off, a faint circle when on.
     Has to stay a transition drawable, VolumeDialogCaptionsButtonViewBinder cross-fades it. -->
<transition xmlns:android="http://schemas.android.com/apk/res/android"
            android:paddingMode="stack">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/transparent" />
        </shape>
    </item>
    <item>
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <solid android:color="@color/volume_panel_oneui_button_selected" />
            </shape>
        </inset>
    </item>
</transition>
