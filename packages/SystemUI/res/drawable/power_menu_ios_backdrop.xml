<!-- Drawn behind the iOS style power menu when window blur is unavailable. The menu is designed
     to sit on a blurred backdrop, so without one the wallpaper shows through the translucent
     rows and the whole thing turns unreadable. A near black radial wash reproduces the look the
     blur gives, at the cost of hiding whatever is behind the dialog. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.42"
        android:gradientRadius="90%p"
        android:startColor="@color/power_menu_ios_backdrop_center"
        android:endColor="@color/power_menu_ios_backdrop_edge" />
</shape>
