<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- HD calling icon -->
    <dimen name="signal_icon_viewport_size">24dp</dimen>

    <!-- Custom Quick Settings -->
    <dimen name="custom_qs_tile_height">76dp</dimen>
    <!-- Start inset of a large tile in the Penguin QS style. Zero on purpose: the icon box already
         pads itself by 8dp on every side, which is also the gap the 56dp circle leaves above and
         below it inside the 72dp tile. Any inset here is added on top of that and pushes the circle
         further from the left edge than it sits from the top and bottom. -->
    <dimen name="custom_qs_tile_start_padding">0dp</dimen>

    <dimen name="power_menu_button_gap_vertical">48dp</dimen>
    <dimen name="power_menu_button_gap_horizontal">54dp</dimen>

    <!-- iOS style power menu -->
    <dimen name="power_menu_ios_thumb_size">80dp</dimen>
    <dimen name="power_menu_ios_track_padding">3dp</dimen>
    <dimen name="power_menu_ios_row_radius">43dp</dimen>
    <dimen name="power_menu_ios_row_margin_horizontal">33dp</dimen>
    <dimen name="power_menu_ios_row_gap">22dp</dimen>
    <dimen name="power_menu_ios_group_gap">52dp</dimen>
    <dimen name="power_menu_ios_hint_margin_top">14dp</dimen>
    <dimen name="power_menu_ios_close_size">72dp</dimen>
    <dimen name="power_menu_ios_close_margin_bottom">48dp</dimen>

    <!-- Expandable volume panel style -->
    <dimen name="volume_panel_expandable_track_size">44dp</dimen>
    <dimen name="volume_panel_expandable_slider_height">148dp</dimen>
    <!-- Half of the track, so every pill is fully rounded. -->
    <dimen name="volume_panel_expandable_track_corner_radius">22dp</dimen>

    <!-- One UI volume panel style -->
    <dimen name="volume_panel_oneui_background_corner_radius">28dp</dimen>
    <dimen name="volume_panel_oneui_padding">20dp</dimen>
    <dimen name="volume_panel_oneui_slider_width">52dp</dimen>
    <dimen name="volume_panel_oneui_track_size">52dp</dimen>
    <dimen name="volume_panel_oneui_track_corner_radius">26dp</dimen>
    <!-- Pill plus the label underneath it. -->
    <dimen name="volume_panel_oneui_slider_container_height">248dp</dimen>
    <dimen name="volume_panel_oneui_slider_spacing">10dp</dimen>
    <dimen name="volume_panel_oneui_header_height">40dp</dimen>
    <!-- Keeps the header readable when the panel is collapsed down to a single pill. -->
    <dimen name="volume_panel_oneui_min_width">260dp</dimen>
</resources>
