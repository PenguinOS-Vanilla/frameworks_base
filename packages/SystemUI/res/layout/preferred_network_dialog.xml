<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="20dp"
        android:text="@string/quick_settings_preferred_network_label"
        android:textColor="?android:attr/colorForeground"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/mode_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/button_settings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/preferred_network_button_outlined"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/quick_settings_preferred_network_settings"
            android:textColor="?android:attr/colorForeground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_done"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/preferred_network_button_filled"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/quick_settings_done"
            android:textColor="?android:attr/colorBackground"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

</LinearLayout>
